; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[accessibility]

general/updates_per_second=30

[application]

config/name="demon summoner"
config/version="0.6.1-alpha"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://sprites/Logo DEMON-SUMMOER.png"

[autoload]

DatosJuego="*res://scripts/datos_juego.gd"
AudioManager="*res://scripts/audio_manager.gd"
ItemManager="*res://scripts/item_manager.gd"
AssetLoader="*res://scripts/asset_loader.gd"

[display]

window/stretch/mode="viewport"
window/stretch/aspect="expand"

[filesystem]

import/blender/enabled=false

